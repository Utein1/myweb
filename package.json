{
  "name": "personalweb",
  "version": "1.0.0",
  "private": true,
  "description": "冒险者档案 — 个人站与内容管理台",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && wrangler d1 execute adventurer-ledger-db --local --file=prisma/migrations/0001_init.sql && next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "db:local:init": "wrangler d1 execute adventurer-ledger-db --local --file=prisma/migrations/0001_init.sql",
    "db:local:seed": "wrangler d1 execute adventurer-ledger-db --local --file=prisma/seed.sql",
    "db:remote:init": "wrangler d1 execute adventurer-ledger-db --remote --file=prisma/migrations/0001_init.sql",
    "db:remote:seed": "wrangler d1 execute adventurer-ledger-db --remote --file=prisma/seed.sql",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "github-slugger": "^2.0.0",
    "jose": "^6.0.13",
    "lucide-react": "^0.544.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.12.2",
    "tailwind-merge": "^3.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "wrangler": "^4.151.2"
  }
}
